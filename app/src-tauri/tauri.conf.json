{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "FrameSight",
  "mainBinaryName": "framesight",
  "version": "0.14.1",
  "identifier": "io.github.jawsbb.framesight",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "FrameSight: Local-first Warframe Companion",
        "width": 1180,
        "height": 760,
        "minWidth": 360,
        "decorations": false,
        "resizable": true,
        "fullscreen": false
      },
      {
        "label": "reward-overlay",
        "title": "FrameSight: Reward Advisor",
        "url": "/overlay",
        "width": 1100,
        "height": 190,
        "visible": false,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "focus": false,
        "focusable": false,
        "skipTaskbar": true,
        "resizable": false,
        "fullscreen": false
      },
      {
        "label": "kiosk-overlay",
        "title": "FrameSight: Ducat Kiosk",
        "url": "/kiosk",
        "width": 1920,
        "height": 1080,
        "visible": false,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "focus": false,
        "focusable": false,
        "skipTaskbar": true,
        "resizable": false,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data: https://raw.githubusercontent.com https://wiki.warframe.com https://warframe.market; style-src 'self'; font-src 'self'; object-src 'none'; frame-src 'none'; base-uri 'self'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "appimage",
      "deb",
      "rpm"
    ],
    "category": "Utility",
    "license": "GPL-3.0-only",
    "licenseFile": "../../LICENSE",
    "homepage": "https://github.com/jawsbb/FrameSight",
    "publisher": "jawsbb",
    "shortDescription": "Local-first Warframe collection and relic companion",
    "longDescription": "FrameSight reads a running Warframe process without modifying it and keeps a local copy of your collection. When a relic cracks it recognises the rewards on screen and prices them in platinum and ducats from warframe.market, counting only sellers who are online. No account, no telemetry, no Overwolf.",
    "resources": {
      "../../LICENSE": "LICENSE",
      "../../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md"
    },
    "linux": {
      "deb": {
        "desktopTemplate": "framesight.desktop.hbs",
        "depends": [
          "libpipewire-0.3-0 | libpipewire-0.3-0t64"
        ],
        "recommends": [
          "tesseract-ocr",
          "tesseract-ocr-eng",
          "x11-utils"
        ]
      },
      "rpm": {
        "desktopTemplate": "framesight.desktop.hbs",
        "depends": [
          "pipewire-libs"
        ],
        "recommends": [
          "/usr/bin/tesseract",
          "/usr/bin/xwininfo"
        ]
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ4NDE0RUJBRjI0NTg4ClJXU0lSZks2VGtIWUFHZ21PQXBEMHVnMklCL2RuYk1SNllTVE1UNG45RHVVOURTV2ZGS2F1ZnlmCg==",
      "endpoints": [
        "https://github.com/jawsbb/FrameSight/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
